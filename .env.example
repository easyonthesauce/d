# Your ElevenLabs Conversational AI agent id (see agent/README.md to create one)
VITE_ELEVENLABS_AGENT_ID=agent_4101m4h556q0emn92a73ydswh30d

# Optional: if your agent is private (auth enabled), the dev server mints signed URLs
# with this key so it never reaches the browser.
ELEVENLABS_API_KEY=

# Folder the game scans for songs (mp3/wav/ogg/m4a/flac). Defaults to ./music
MUSIC_DIR=./music

# Screen orientation: portrait (default) or landscape
VITE_ORIENTATION=portrait
